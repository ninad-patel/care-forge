# ==============================================================================
# CareForge Backend Environment Configuration Template
# Copy this file to .env and fill in your actual credentials.
# NEVER commit your actual .env file to version control.
# ==============================================================================

# PostgreSQL Connection String (Supabase / Neon / Local PostgreSQL)
# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DBNAME
# Note: If your connection string starts with 'postgresql://', the app will
# automatically normalize it to use the modern 'postgresql+psycopg://' driver.
DATABASE_URL=postgresql+psycopg://postgres.[project-ref]:[your-password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Google Gemini API Key (for parallel 1,000-word blog generation with Gemini 2.5 Flash)
# Obtain a free key from: https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API Key (Optional fallback provider: llama-3.3-70b-versatile)
# Obtain from: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Allowed CORS Origins (comma-separated list for frontend access)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Environment Mode: development | test | production
ENVIRONMENT=development
